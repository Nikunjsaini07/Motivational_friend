{
  "manifest_version": 3,
  "name": "Motivation Friend",
  "version": "0.3.2",
  "minimum_chrome_version": "127",
  "description": "A local-only study companion that interrupts distraction and protects focus.",
  "permissions": ["storage", "tabs", "alarms", "offscreen"],
  "icons": { "16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png" },
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Motivation Friend",
    "default_popup": "src/popup.html",
    "default_icon": { "16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png" }
  }
}
